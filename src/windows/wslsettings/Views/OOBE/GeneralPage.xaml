<Page
    x:Class="WslSettings.Views.OOBE.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctControls="using:CommunityToolkit.WinUI.Controls"
    xmlns:behaviors="using:WslSettings.Behaviors"
    xmlns:controls="using:WslSettings.Controls"
    behaviors:NavigationViewHeaderBehavior.HeaderMode="Never">

    <controls:OOBEContent x:Uid="Settings_OOBEGeneral" HeroImage="ms-appx:///Assets/SettingsOOBEGeneral.png">
        <controls:OOBEContent.PageContent>
            <StackPanel Orientation="Vertical" Spacing="{StaticResource SettingsCardSpacing}">
                <InfoBar x:Uid="Settings_KeepWslVmAlwaysOnError" Severity="Error" IsClosable="False" Margin="{StaticResource SettingsCardMargin}"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"/>
                <ctControls:SettingsCard x:Uid="Settings_KeepWslVmAlwaysOn">
                    <ctControls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xe945;"/>
                    </ctControls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Uid="Settings_KeepWslVmAlwaysOnToggleSwitch" HorizontalAlignment="Right" MinWidth="0"
                        IsOn="{x:Bind ViewModel.IsKeepWslRunning, Mode=TwoWay}"/>
                </ctControls:SettingsCard>
                <TextBlock x:Uid="Settings_KeepWslVmAlwaysOnOOBEFooter" Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="{StaticResource XXSmallTopMargin}"/>
                <StackPanel Orientation="Vertical" Margin="{StaticResource MediumTopMargin}">
                    <HyperlinkButton x:Uid="Settings_OOBEGeneral_WSLDocumentationLink" Style="{StaticResource TextButtonStyle}"/>
                    <HyperlinkButton x:Uid="Settings_OOBEGeneral_BestPracticesSetupLink" Style="{StaticResource TextButtonStyle}"/>
                    <HyperlinkButton x:Uid="Settings_OOBEGeneral_GettingStartedLinuxLink" Style="{StaticResource TextButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </controls:OOBEContent.PageContent>
    </controls:OOBEContent>
</Page>