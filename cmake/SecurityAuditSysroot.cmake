set(sysroot_manifest "${CMAKE_SOURCE_DIR}/tools/securityaudit/cgmanifest.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${sysroot_manifest}")
file(READ "${sysroot_manifest}" sysroot_packages)
file(SHA256 "${sysroot_manifest}" manifest_hash)
file(SHA256 "${CMAKE_CURRENT_LIST_FILE}" extractor_hash)
string(SHA256 sysroot_hash "${manifest_hash}${extractor_hash}")
set(sysroot_cache "${CMAKE_BINARY_DIR}/_deps/${TARGET_PLATFORM}/audit-sysroot/${sysroot_hash}")
set(AUDIT_SYSROOT "${sysroot_cache}/root")

if(NOT EXISTS "${sysroot_cache}/complete")
    string(JSON package_count LENGTH "${sysroot_packages}" registrations)
    math(EXPR last_package "${package_count} - 1")
    foreach(index RANGE ${last_package})
        string(JSON component GET "${sysroot_packages}" registrations ${index} component other)
        string(JSON name GET "${component}" name)
        if(NOT name MATCHES "-${AUDIT_DEB_ARCH}$")
            continue()
        endif()
        string(JSON url GET "${component}" downloadUrl)
        string(JSON hash GET "${component}" hash)
        if(NOT hash MATCHES "^sha256:([a-f0-9]+)$")
            message(FATAL_ERROR "Audit dependency must have a SHA256: ${name}")
        endif()
        set(hash "${CMAKE_MATCH_1}")
        get_filename_component(name "${url}" NAME)
        set(archive "${CMAKE_BINARY_DIR}/_deps/audit-packages/${name}")
        file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/_deps/audit-packages")
        if(EXISTS "${archive}")
            file(SHA256 "${archive}" actual_hash)
            if(NOT actual_hash STREQUAL hash)
                message(FATAL_ERROR "Cached audit dependency has an invalid SHA256: ${archive}")
            endif()
        else()
            message(STATUS "Downloading audit dependency: ${name}")
            file(DOWNLOAD "${url}" "${archive}.download"
                EXPECTED_HASH "SHA256=${hash}" TLS_VERIFY ON STATUS download_status)
            list(GET download_status 0 download_code)
            if(NOT download_code EQUAL 0)
                file(REMOVE "${archive}.download")
                message(FATAL_ERROR "Cannot download audit dependency ${name}: ${download_status}")
            endif()
            file(RENAME "${archive}.download" "${archive}")
        endif()
        set(unpack "${sysroot_cache}/archives/${name}")
        file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${unpack}")
        file(GLOB data "${unpack}/data.tar.*")
        list(LENGTH data data_count)
        if(NOT data_count EQUAL 1)
            message(FATAL_ERROR "Expected one data archive in ${archive}")
        endif()
        file(ARCHIVE_EXTRACT INPUT "${data}" DESTINATION "${AUDIT_SYSROOT}")
    endforeach()

    # Ubuntu's linker scripts use /lib paths in a merged-/usr filesystem.
    file(TO_NATIVE_PATH "usr/lib" lib_target)
    file(CREATE_LINK "${lib_target}" "${AUDIT_SYSROOT}/lib" SYMBOLIC)
    if(EXISTS "${AUDIT_SYSROOT}/usr/lib64")
        file(TO_NATIVE_PATH "usr/lib64" lib64_target)
        file(CREATE_LINK "${lib64_target}" "${AUDIT_SYSROOT}/lib64" SYMBOLIC)
    endif()
    file(WRITE "${sysroot_cache}/complete" "${sysroot_hash}\n")
endif()
