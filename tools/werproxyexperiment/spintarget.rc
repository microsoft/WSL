#include <windows.h>

#ifndef SPINTARGET_FILE_NAME
#define SPINTARGET_FILE_NAME "winget.exe"
#endif

#ifndef SPINTARGET_PRODUCT_NAME
#define SPINTARGET_PRODUCT_NAME "Windows Package Manager"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1, 26, 0, 0
PRODUCTVERSION 1, 26, 0, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Microsoft Corporation"
            VALUE "FileDescription", SPINTARGET_PRODUCT_NAME
            VALUE "FileVersion", "1.26.0.0"
            VALUE "InternalName", SPINTARGET_FILE_NAME
            VALUE "OriginalFilename", SPINTARGET_FILE_NAME
            VALUE "ProductName", SPINTARGET_PRODUCT_NAME
            VALUE "ProductVersion", "1.26.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
