cmake_minimum_required(VERSION 3.25)
file(STRINGS "${INPUT}" lines)
set(configuration "")
set(names "")
set(numbers "")
foreach(line IN LISTS lines)
    if(NOT line MATCHES "WSL_AUDIT_SYSCALL")
        continue()
    endif()
    if(NOT line MATCHES "^WSL_AUDIT_SYSCALL\\(([0-9]+),[ \t]*([a-z0-9_]+),[ \t]*([0-6])\\)$")
        message(FATAL_ERROR "Unresolved or invalid target syscall: ${line}")
    endif()
    set(number "${CMAKE_MATCH_1}")
    set(name "${CMAKE_MATCH_2}")
    set(arguments "${CMAKE_MATCH_3}")
    if(number IN_LIST numbers OR name IN_LIST names)
        message(FATAL_ERROR "Duplicate syscall: ${line}")
    endif()
    list(APPEND names "${name}")
    list(APPEND numbers "${number}")
    string(APPEND configuration "${number}=${name},${arguments}\n")
endforeach()
list(LENGTH names count)
if(NOT count EQUAL 17)
    message(FATAL_ERROR "Expected 17 configured audit syscalls, found ${count}")
endif()
file(CONFIGURE OUTPUT "${OUTPUT}" CONTENT "${configuration}" @ONLY NEWLINE_STYLE UNIX)
file(TOUCH "${OUTPUT}")
