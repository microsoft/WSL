cmake_minimum_required(VERSION 3.25)

set(payload "@AUDIT_PAYLOAD_DIR@")
set(package "@MDE_PACKAGE_DIR@")
set(emulator "@CMAKE_CROSSCOMPILING_EMULATOR@")
set(objdump "@CMAKE_OBJDUMP@")
if("@CMAKE_SYSTEM_PROCESSOR@" MATCHES "aarch64|arm64")
    set(architecture arm64)
    set(machine aarch64)
    set(triplet aarch64-linux-gnu)
    set(loader ld-linux-aarch64.so.1)
    set(syscalls syscalls_aarch64.conf)
else()
    set(architecture x64)
    set(machine i386:x86-64)
    set(triplet x86_64-linux-gnu)
    set(loader ld-linux-x86-64.so.2)
    set(syscalls syscalls.conf)
endif()

file(MAKE_DIRECTORY "${payload}/runtime" "${payload}/licenses")
file(COPY_FILE "${COLLECTOR}" "${payload}/wsl_audit_collector")
execute_process(COMMAND ${emulator} "${SYSCALL_GENERATOR}"
    OUTPUT_FILE "${payload}/${syscalls}" COMMAND_ERROR_IS_FATAL ANY)
file(COPY_FILE "${package}/lib/libebpf_loader.so" "${payload}/libebpf_loader.so")
foreach(variant raw_tp_sub4096 raw_tp raw_tp_args64_krsi)
    set(name "ebpf_wrapper_kern_${variant}_btf_rbuff_enriched_fmap.o")
    file(COPY_FILE "${package}/include/ebpf/${name}" "${payload}/${name}")
endforeach()

# Resolve the entire ELF dependency closure using only this architecture's runtime
# and the matching NuGet package. Materialize symlinks before crossing to Windows.
set(queue "${payload}/wsl_audit_collector" "${payload}/libebpf_loader.so")
set(visited "")
set(names "")
while(queue)
    list(POP_FRONT queue binary)
    if(binary IN_LIST visited)
        continue()
    endif()
    list(APPEND visited "${binary}")
    execute_process(COMMAND "${objdump}" -f "${binary}" OUTPUT_VARIABLE header COMMAND_ERROR_IS_FATAL ANY)
    if(NOT header MATCHES "architecture: ${machine},")
        message(FATAL_ERROR "Wrong architecture in ${binary}: ${header}")
    endif()
    execute_process(COMMAND "${objdump}" -p "${binary}" OUTPUT_VARIABLE dynamic COMMAND_ERROR_IS_FATAL ANY)
    string(REGEX MATCHALL "NEEDED[ \t]+[^ \t\r\n]+" needed "${dynamic}")
    list(APPEND needed "NEEDED ${loader}")
    foreach(entry IN LISTS needed)
        string(REGEX REPLACE "NEEDED[ \t]+" "" name "${entry}")
        if(name IN_LIST names)
            continue()
        endif()
        # MDE's libc++.so is a linker script, not a redistributable runtime.
        # Use a matched libc++/libc++abi pair from the target distribution.
        unset(source)
        find_file(source NAMES "${name}" PATHS
            "/usr/lib/${triplet}" "/lib/${triplet}" "/usr/${triplet}/lib"
            NO_DEFAULT_PATH NO_CACHE REQUIRED)
        file(COPY_FILE "${source}" "${payload}/runtime/${name}")
        list(APPEND names "${name}")
        list(APPEND queue "${payload}/runtime/${name}")
    endforeach()
endwhile()

# Retain the distribution notices for every system runtime included in the payload.
foreach(dependency IN LISTS visited)
    if(dependency MATCHES "/runtime/")
        get_filename_component(name "${dependency}" NAME)
        set(notice_found FALSE)
        foreach(path "/usr/lib/${triplet}/${name}" "/lib/${triplet}/${name}" "/usr/${triplet}/lib/${name}")
            if(EXISTS "${path}")
                file(REAL_PATH "${path}" real_path)
                foreach(candidate "${real_path}" "${path}")
                    execute_process(COMMAND dpkg-query -S "${candidate}" OUTPUT_VARIABLE owner RESULT_VARIABLE status ERROR_QUIET)
                    if(status EQUAL 0)
                        string(REGEX MATCH "^[^:\r\n]+" owner "${owner}")
                        if(EXISTS "/usr/share/doc/${owner}/copyright")
                            file(COPY_FILE "/usr/share/doc/${owner}/copyright" "${payload}/licenses/${owner}.txt")
                            set(notice_found TRUE)
                            break()
                        endif()
                    endif()
                endforeach()
                if(notice_found)
                    break()
                endif()
            endif()
        endforeach()
        if(NOT notice_found)
            message(FATAL_ERROR "Missing distribution copyright notice for ${name}")
        endif()
    endif()
endforeach()
file(COPY_FILE "@WSL_SOURCE_DIR@/NOTICE.txt" "${payload}/licenses/WSL-NOTICE.txt")
file(COPY_FILE "@nlohmannjson_SOURCE_DIR@/LICENSE.MIT" "${payload}/licenses/nlohmann-json.txt")

file(GLOB_RECURSE files RELATIVE "${payload}" "${payload}/*")
list(REMOVE_ITEM files payload.json)
list(SORT files)
set(manifest "{}")
string(JSON manifest SET "${manifest}" formatVersion 1)
string(JSON manifest SET "${manifest}" architecture "\"${architecture}\"")
string(JSON manifest SET "${manifest}" files "{}")
string(JSON manifest SET "${manifest}" sources "{}")
file(GLOB source_files RELATIVE "@WSL_SOURCE_DIR@"
    "@WSL_SOURCE_DIR@/src/linux/securityaudit/*.cpp"
    "@WSL_SOURCE_DIR@/src/linux/securityaudit/Collector.h"
    "@WSL_SOURCE_DIR@/src/shared/securityaudit/*.h")
list(APPEND source_files packages.config src/linux/securityaudit/CMakeLists.txt
    tools/securityaudit/StagePayload.cmake.in tools/securityaudit/build-collector.sh)
foreach(source IN LISTS source_files)
    file(READ "@WSL_SOURCE_DIR@/${source}" contents)
    string(REPLACE "\r\n" "\n" contents "${contents}")
    string(SHA256 hash "${contents}")
    string(JSON manifest SET "${manifest}" sources "${source}" "\"${hash}\"")
endforeach()
foreach(file IN LISTS files)
    file(SHA256 "${payload}/${file}" hash)
    string(JSON manifest SET "${manifest}" files "${file}" "\"${hash}\"")
endforeach()
file(WRITE "${payload}/payload.json" "${manifest}\n")
