set(output "@WSL_AUDIT_PAYLOAD_OUTPUT@")
if(output STREQUAL "")
    message(FATAL_ERROR "WSL_AUDIT_PAYLOAD_OUTPUT is required")
endif()
set(COLLECTOR "@CMAKE_CURRENT_BINARY_DIR@/wsl_audit_collector")
set(ARCHITECTURE "@CMAKE_SYSTEM_PROCESSOR@")
include("@CMAKE_CURRENT_LIST_DIR@/VerifyElf.cmake")
set(collector "${COLLECTOR}")
file(MAKE_DIRECTORY "${output}/wsl-security-audit")
file(COPY_FILE "${collector}" "${output}/wsl-audit-collector" ONLY_IF_DIFFERENT)
set(payload_files wsl-audit-collector)
foreach(program ebpf_wrapper_kern_raw_tp_sub4096 ebpf_wrapper_kern_raw_tp ebpf_wrapper_kern_raw_tp_args64_krsi)
    set(name "${program}_btf_rbuff_enriched_fmap.o")
    file(COPY_FILE "@WSL_AUDIT_EBPF_STATIC_PACKAGE@/${name}" "${output}/wsl-security-audit/${name}" ONLY_IF_DIFFERENT)
    list(APPEND payload_files "wsl-security-audit/${name}")
endforeach()
if("@CMAKE_SYSTEM_PROCESSOR@" STREQUAL "aarch64")
    set(syscalls syscalls_aarch64.conf)
else()
    set(syscalls syscalls.conf)
endif()
file(COPY_FILE "@WSL_AUDIT_EBPF_STATIC_PACKAGE@/${syscalls}" "${output}/wsl-security-audit/${syscalls}" ONLY_IF_DIFFERENT)
list(APPEND payload_files "wsl-security-audit/${syscalls}")
set(manifest "{\"formatVersion\":1,\"protocolVersion\":2,\"architecture\":\"@CMAKE_SYSTEM_PROCESSOR@\"}")
string(JSON manifest SET "${manifest}" loaderRevision "\"@WSL_SECURITYAUDIT_LOADER_REVISION@\"")
string(JSON manifest SET "${manifest}" sourceDigest "\"@WSL_SECURITYAUDIT_SOURCE_DIGEST@\"")
string(JSON manifest SET "${manifest}" sourceFiles [==[@audit_source_json@]==])
execute_process(COMMAND git -c "safe.directory=@WSL_AUDIT_EBPF_SOURCE_ROOT@" diff --binary HEAD WORKING_DIRECTORY "@WSL_AUDIT_EBPF_SOURCE_ROOT@"
    OUTPUT_VARIABLE loader_diff COMMAND_ERROR_IS_FATAL ANY)
string(SHA256 loader_diff_hash "${loader_diff}")
string(JSON manifest SET "${manifest}" loaderDiffSha256 "\"${loader_diff_hash}\"")
execute_process(COMMAND git -c "safe.directory=@WSL_AUDIT_EBPF_SOURCE_ROOT@/libbpf" rev-parse HEAD WORKING_DIRECTORY "@WSL_AUDIT_EBPF_SOURCE_ROOT@/libbpf"
    OUTPUT_VARIABLE libbpf_revision OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
string(JSON manifest SET "${manifest}" libbpfRevision "\"${libbpf_revision}\"")
execute_process(COMMAND git -c "safe.directory=@WSL_AUDIT_EBPF_SOURCE_ROOT@/libbpf" diff --binary HEAD WORKING_DIRECTORY "@WSL_AUDIT_EBPF_SOURCE_ROOT@/libbpf"
    OUTPUT_VARIABLE libbpf_diff COMMAND_ERROR_IS_FATAL ANY)
string(SHA256 libbpf_diff_hash "${libbpf_diff}")
string(JSON manifest SET "${manifest}" libbpfDiffSha256 "\"${libbpf_diff_hash}\"")
file(SHA256 "@WSL_AUDIT_EBPF_STATIC_PACKAGE@/libebpf_loader.a" loader_archive)
file(SHA256 "@WSL_AUDIT_EBPF_STATIC_PACKAGE@/libbpf.a" libbpf_archive)
string(JSON manifest SET "${manifest}" loaderArchiveSha256 "\"${loader_archive}\"")
string(JSON manifest SET "${manifest}" libbpfArchiveSha256 "\"${libbpf_archive}\"")
file(STRINGS "@WSL_AUDIT_EBPF_SOURCE_ROOT@/3rdpartycode/event_defs.h" abi REGEX "^#define VERSION [0-9]+$")
string(REGEX REPLACE "^#define VERSION ([0-9]+)$" "\\1" abi "${abi}")
if(NOT abi MATCHES "^[0-9]+$")
    message(FATAL_ERROR "Cannot identify loader event ABI")
endif()
string(JSON manifest SET "${manifest}" eventAbiVersion "${abi}")
string(JSON manifest SET "${manifest}" compiler "\"@CMAKE_CXX_COMPILER_ID@ @CMAKE_CXX_COMPILER_VERSION@\"")
string(JSON manifest SET "${manifest}" libelfVersion "\"@ELF_VERSION@\"")
set(static_dependencies "{}")
set(archives "@audit_archives@;@audit_zlib@")
foreach(archive IN LISTS archives)
    get_filename_component(name "${archive}" NAME)
    file(SHA256 "${archive}" hash)
    string(JSON static_dependencies SET "${static_dependencies}" "${name}" "\"${hash}\"")
endforeach()
string(JSON manifest SET "${manifest}" staticDependencies "${static_dependencies}")
set(files "{}")
foreach(path IN LISTS payload_files)
    file(SHA256 "${output}/${path}" hash)
    string(JSON files SET "${files}" "${path}" "\"${hash}\"")
endforeach()
string(JSON manifest SET "${manifest}" files "${files}")
file(WRITE "${output}/audit-payload.json" "${manifest}\n")
message(STATUS "Staged static @CMAKE_SYSTEM_PROCESSOR@ audit payload: ${output}")
