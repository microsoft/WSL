cmake_minimum_required(VERSION 3.25)
set(payload "@AUDIT_PAYLOAD_DIR@")
set(sysroot "@AUDIT_SYSROOT@")
set(triplet "@AUDIT_TRIPLET@")
set(loader "@AUDIT_LOADER@")
set(readobj [==[@LLVM_INSTALL_DIR@/llvm-readobj.exe]==])
if("@TARGET_PLATFORM@" STREQUAL "x64")
    set(machine 62)
else()
    set(machine 183)
endif()

function(read_dependencies binary output)
    execute_process(COMMAND "${readobj}" --elf-output-style=JSON --file-header --needed-libs "${binary}"
        OUTPUT_VARIABLE details COMMAND_ERROR_IS_FATAL ANY)
    string(JSON actual_machine GET "${details}" 0 ElfHeader Machine Value)
    if(NOT actual_machine EQUAL machine)
        message(FATAL_ERROR "Wrong audit ELF architecture: ${binary}")
    endif()
    string(JSON count LENGTH "${details}" 0 NeededLibraries)
    set(dependencies "")
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE ${last})
            string(JSON name GET "${details}" 0 NeededLibraries ${index})
            if(NOT name MATCHES "^[A-Za-z0-9_+.-]+$" OR name MATCHES "^\\.\\.?$")
                message(FATAL_ERROR "Invalid ELF dependency in ${binary}: ${name}")
            endif()
            list(APPEND dependencies "${name}")
        endforeach()
    endif()
    set(${output} "${dependencies}" PARENT_SCOPE)
endfunction()

if(PREPARE)
    file(MAKE_DIRECTORY "${payload}/runtime" "${payload}/licenses")
    file(COPY_FILE "@MDE_SOURCE_DIR@/lib/libebpf_loader.so" "${payload}/libebpf_loader.so" ONLY_IF_DIFFERENT)
    foreach(variant raw_tp_sub4096 raw_tp raw_tp_args64_krsi)
        set(name "ebpf_wrapper_kern_${variant}_btf_rbuff_enriched_fmap.o")
        file(COPY_FILE "@MDE_SOURCE_DIR@/include/ebpf/${name}" "${payload}/${name}" ONLY_IF_DIFFERENT)
    endforeach()
    read_dependencies("${payload}/libebpf_loader.so" queue)
    list(APPEND queue "${loader}" libstdc++.so.6 libgcc_s.so.1 libc.so.6 libm.so.6)
    set(visited "")
    while(queue)
        list(POP_FRONT queue name)
        if(name IN_LIST visited)
            continue()
        endif()
        set(source "${sysroot}/usr/lib/${triplet}/${name}")
        if(NOT EXISTS "${source}")
            message(FATAL_ERROR "Pinned audit sysroot is missing ${name}")
        endif()
        read_dependencies("${source}" dependencies)
        # COPY_FILE materializes symlinks so installed files never depend on the build sysroot.
        file(COPY_FILE "${source}" "${payload}/runtime/${name}" ONLY_IF_DIFFERENT)
        list(APPEND visited "${name}")
        list(APPEND queue ${dependencies})
    endwhile()
    file(READ "@CMAKE_SOURCE_DIR@/tools/securityaudit/cgmanifest.json" manifest)
    string(JSON count LENGTH "${manifest}" registrations)
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
        string(JSON package GET "${manifest}" registrations ${index} component other name)
        if(NOT package MATCHES "^(.*)-@AUDIT_DEB_ARCH@$")
            continue()
        endif()
        set(package "${CMAKE_MATCH_1}")
        file(COPY_FILE "${sysroot}/usr/share/doc/${package}/copyright"
            "${payload}/licenses/${package}.txt" ONLY_IF_DIFFERENT)
    endforeach()
    file(COPY_FILE "@CMAKE_SOURCE_DIR@/NOTICE.txt" "${payload}/licenses/WSL-NOTICE.txt" ONLY_IF_DIFFERENT)
    file(COPY_FILE "@NLOHMAN_JSON_SOURCE_DIR@/LICENSE.MIT" "${payload}/licenses/nlohmann-json.txt" ONLY_IF_DIFFERENT)
else()
    # Check the linked collector as well as MDE, including every transitive dependency.
    file(GLOB libraries "${payload}/runtime/*")
    foreach(binary "${payload}/wsl_audit_collector" "${payload}/libebpf_loader.so" ${libraries})
        read_dependencies("${binary}" dependencies)
        foreach(name IN LISTS dependencies)
            if(NOT EXISTS "${payload}/runtime/${name}")
                message(FATAL_ERROR "Audit payload is missing ${name}, required by ${binary}")
            endif()
        endforeach()
    endforeach()
    execute_process(COMMAND powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass
        -File "@AUDIT_TOOLS_DIR@/Validate-Payload.ps1" -CreateManifest
        -PayloadDirectory "${payload}" -Architecture "@TARGET_PLATFORM@" -SourceDirectory "@CMAKE_SOURCE_DIR@"
        COMMAND_ERROR_IS_FATAL ANY)
endif()
