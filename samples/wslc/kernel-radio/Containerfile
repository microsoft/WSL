FROM debian:trixie-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-psutil curl \
    && rm -rf /var/lib/apt/lists/*

COPY kernel-radio.py .

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=2s --start-period=5s --retries=3 \
    CMD curl --fail --silent http://127.0.0.1:8000/api || exit 1

CMD ["python3", "-u", "kernel-radio.py"]
